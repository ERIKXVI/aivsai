// Windows resources (application icon and version information). CMake's configure_file() writes
// <build>/generated/app.rc from resources/app.rc.in, stamping the version from project(VERSION):
// edit the template, not the generated copy.
#include <winver.h>

// GLFW gives its window class the icon resource named GLFW_ICON, so the running game shows it on the
// taskbar, in Alt+Tab and in the title bar (Explorer uses the first icon group, this same one).
GLFW_ICON ICON "@PROJECT_SOURCE_DIR@/resources/icon.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION  @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Prima Materia"
            VALUE "FileDescription",  "Prima Materia - a falling-sand alchemy roguelite"
            VALUE "FileVersion",      "@PROJECT_VERSION@"
            VALUE "InternalName",     "PrimaMateria"
            VALUE "OriginalFilename", "PrimaMateria.exe"
            VALUE "ProductName",      "Prima Materia"
            VALUE "ProductVersion",   "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
