# Converts a list of text files into a C++ source file holding null-terminated
# byte arrays, so shaders ship inside the executable (no loose files to lose).
#
# Invoked in script mode:
#   cmake -DOUTPUT=<file.cpp> -DHEADER=<file.hpp> -DINPUTS="a.glsl;b.glsl" -P EmbedFiles.cmake

if(NOT OUTPUT OR NOT HEADER OR NOT INPUTS)
    message(FATAL_ERROR "EmbedFiles.cmake requires OUTPUT, HEADER and INPUTS")
endif()

set(header_body "// Generated by cmake/EmbedFiles.cmake. Do not edit.\n#pragma once\n\nnamespace pm::embedded {\n\n")
set(source_body "// Generated by cmake/EmbedFiles.cmake. Do not edit.\n#include \"EmbeddedShaders.hpp\"\n\nnamespace pm::embedded {\n\n")

foreach(input IN LISTS INPUTS)
    get_filename_component(name "${input}" NAME)
    string(MAKE_C_IDENTIFIER "${name}" ident)
    file(READ "${input}" hex HEX)
    string(LENGTH "${hex}" hex_len)
    # Turn "a1b2..." into "0xa1,0xb2,..." and append the null terminator.
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(APPEND source_body "static const unsigned char k_${ident}_data[] = {${bytes}0x00};\n")
    string(APPEND source_body "const char* const ${ident} = reinterpret_cast<const char*>(k_${ident}_data);\n\n")
    string(APPEND header_body "extern const char* const ${ident};\n")
endforeach()

string(APPEND header_body "\n} // namespace pm::embedded\n")
string(APPEND source_body "} // namespace pm::embedded\n")

# Only touch the outputs when content changes to avoid needless rebuilds.
foreach(pair "HEADER;header_body" "OUTPUT;source_body")
    list(GET pair 0 path_var)
    list(GET pair 1 body_var)
    set(path "${${path_var}}")
    set(body "${${body_var}}")
    set(old "")
    if(EXISTS "${path}")
        file(READ "${path}" old)
    endif()
    if(NOT old STREQUAL body)
        file(WRITE "${path}" "${body}")
    endif()
endforeach()
